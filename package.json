{
  "name": "novachat",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "NovaChat — anonymous chat platform (React client + Node server)",
  "scripts": {
    "start": "node web/server/src/index.js",
    "dev:server": "npm --prefix web/server run dev",
    "dev:client": "npm --prefix web/client run dev",
    "build:client": "npm --prefix web/client run build",
    "test": "npm --prefix web/server test",
    "lint": "npm --prefix web/server run lint && npm --prefix web/client run lint",
    "install:all": "npm --prefix web/server install && npm --prefix web/client install"
  },
  "dependencies": {
    "bad-words": "^4.0.0",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.18.3",
    "express-rate-limit": "^8.3.1",
    "groq-sdk": "^1.1.2",
    "helmet": "^8.1.0",
    "ioredis": "^5.3.2",
    "socket.io": "^4.7.4",
    "swagger-jsdoc": "^6.2.8",
    "swagger-ui-express": "^5.0.0",
    "uuid": "^9.0.1"
  },
  "devDependencies": {
    "@vitest/coverage-v8": "^1.0.0",
    "eslint": "^8.57.0",
    "nodemon": "^3.1.0",
    "socket.io-client": "^4.7.4",
    "supertest": "^6.3.3",
    "vitest": "^1.0.0"
  }
}
