PORT=4000
NODE_ENV=production

# Redis — use Upstash Redis URL in production (falls back to in-memory if unavailable)
REDIS_URL=redis://localhost:6379

# Your Vercel client URL (no trailing slash)
CLIENT_URL=https://your-app.vercel.app

# Generate a strong random string: openssl rand -hex 32
JWT_SECRET=change-this-to-a-long-random-secret-in-production

# Groq API key for AI icebreakers and chat summaries (optional — AI features disabled if missing)
# Get yours at: https://console.groq.com
GROQ_API_KEY=

# Metered TURN API key for WebRTC video calls (optional — falls back to free open relay)
# Get yours at: https://www.metered.ca
METERED_API_KEY=
