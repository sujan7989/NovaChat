PORT=4000
NODE_ENV=production

# Redis — use Upstash Redis URL in production (falls back to in-memory if unavailable)
REDIS_URL=redis://localhost:6379

# Your Vercel client URL (no trailing slash)
CLIENT_URL=https://your-app.vercel.app

# Generate a strong random string: openssl rand -hex 32
JWT_SECRET=change-this-to-a-long-random-secret-in-production

# Groq API key for AI icebreakers and chat summaries (optional — AI features disabled if missing)
# Get yours at: https://console.groq.com
GROQ_API_KEY=

# ── TURN server config (pick ONE provider, or leave all blank for free public fallback) ──

# OPTION 1: Metered managed TURN (recommended — free 50GB/month, best reliability)
# Sign up at https://www.metered.ca → Dashboard → TURN → create app
METERED_API_KEY=
METERED_APP_NAME=novachat
# Optional: pin nearest region (e.g. india, singapore, asia)
METERED_REGION=

# OPTION 2: Xirsys TURN (free 500MB/month)
# Sign up at https://xirsys.com → Dashboard → create a channel
XIRSYS_IDENT=
XIRSYS_SECRET=
XIRSYS_CHANNEL=novachat

# Your Render service external URL (e.g. https://novachat-server-xxxx.onrender.com)
# Set this to enable the 14-minute keep-alive self-ping that prevents free-tier spin-down.
RENDER_EXTERNAL_URL=
