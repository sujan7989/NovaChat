{
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "framework": "vite",
  "rewrites": [
    { "source": "/sitemap.xml", "destination": "/api/sitemap.xml" },
    { "source": "/((?!api/|robots.txt|sitemap.xml|favicon.svg|manifest.json|assets/).*)", "destination": "/index.html" }
  ]
}
